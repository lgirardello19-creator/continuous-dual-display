# Configuração do setup de duas telas contínuas
# Copie para `.env` e ajuste para a sua máquina (ou deixe a IA preencher automaticamente)

# Rede entre Host (PC principal) e Cliente (notebook/segundo dispositivo)
HOST_IP="10.42.0.228"
HOST_FALLBACK_IP=""
CLIENT_SUBNET="10.42.0.0/24"
WIFI_SUBNET=""
HOST_SSH_USER="pc"
ETH_IFACE="enp4s0"
ETH_CONN_NAME="Cabo-Segundo-Monitor"

# Monitor principal e virtual no Host
SUNSHINE_NAME="PC-Principal"
PRIMARY_OUTPUT="HDMI-A-1"
PRIMARY_WIDTH="1920"
PRIMARY_HEIGHT="1080"
VIRTUAL_NAME="SecondScreen"
VIRTUAL_OUTPUT_NAME="Virtual-SecondScreen"
VIRTUAL_WIDTH="1920"
VIRTUAL_HEIGHT="1080"
VIRTUAL_SCALE="1"
VIRTUAL_SIDE="left"   # left ou right (em relação ao monitor principal)

# Streaming (Moonlight + Sunshine)
APP_NAME="Monitor Estendido"
STREAM_FPS="60"
STREAM_BITRATE_KBPS="80000"   # 80000 em cabo Gigabit; 30000-45000 em Wi-Fi 5/6 GHz
MOONLIGHT_VERSION="6.2.0"

# Calibração inicial de brilho/cor do monitor físico do Host (via DDC/CI, opcional)
HOST_BRIGHTNESS="90"
HOST_CONTRAST="80"
HOST_COLOR_PRESET_VCP="05"    # 05 = 6500 K na maioria dos monitores DDC/CI
